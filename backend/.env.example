# Server Configuration
PORT=5000
NODE_ENV=development

# Mock Store URL (target site)
MOCK_STORE_URL=https://demo.inelabteamdev.com

# Supabase Configuration (Optional for local dev, required for cloud PostgreSQL)
# If left empty, backend automatically uses local persistent JSON store (data/db.json)
SUPABASE_URL=
SUPABASE_KEY=

# Secret for protecting external cron webhook POST /api/cron/scrape (e.g. from cron-job.org)
CRON_SECRET=super-secret-cron-token-123
